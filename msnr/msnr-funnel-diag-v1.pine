//@version=6
// MSNR funnel-диагностика (Этап 1). НИЧЕГО НЕ ТОРГУЕТ.
//
// Блоки 1-4 перенесены из msnr-trend-pullback-v1.1.pine ДОСЛОВНО, добавлены только счётчики.
// Сам v1.1 не изменялся — измеряемый объект должен остаться прежним.
//
// ОГРАНИЧЕНИЕ: у индикатора нет позиции, поэтому нет стадии «занято».
// Стадии h (прошли фильтры) и i (входы) берутся из прогона стратегии v1.1, не отсюда.
// Здесь честно измеряется только ГЕНЕРАЦИЯ сигнала: a → g.
indicator("MSNR Funnel Diag v1", "MSNRdiag", overlay = true, max_bars_back = 1000)

// ---- инпуты = строгие дефолты v1.1
string tfTrend  = input.timeframe("240", "ТФ тренда")
int    pivTrend = input.int(3, "Пивот тренда", minval = 1)
string tfZone   = input.timeframe("60", "ТФ зон")
int    pivZone  = input.int(5, "Пивот зон", minval = 1)
int    maxZones = input.int(3, "Макс. POI-зон в сторону", minval = 1)
bool   bornFresh = input.bool(true, "POI рождается свежей")
int    entryWindow = input.int(5, "Окно входа, баров", minval = 1)
int    confirmBars = input.int(2, "Дедлайн подтверждения", minval = 1)
bool   confirmInsideWindow = input.bool(false, "Подтверждение внутри окна")
float  wickRatio    = input.float(0.5, "А: доля фитиля", minval = 0.1, maxval = 0.9, step = 0.05)
float  minRangeAtr  = input.float(0.8, "А: размер ×ATR", minval = 0.0, step = 0.1)
int    atrLen   = input.int(14, "ATR", minval = 1)
float  deadMult = input.float(5.0, "«Мёртвый слот»: дальше N×ATR", minval = 1.0, step = 0.5)
int    ageEvery = input.int(50, "Сэмплировать возраст зон раз в N баров", minval = 1)

// ================= СТАРШИЕ ТФ (копия v1.1) =================
f_trend() =>
    float ph = ta.pivothigh(pivTrend, pivTrend)
    float pl = ta.pivotlow(pivTrend, pivTrend)
    var float h0 = na
    var float h1 = na
    var float l0 = na
    var float l1 = na
    if not na(ph)
        h1 := h0
        h0 := ph
    if not na(pl)
        l1 := l0
        l0 := pl
    int tr = 0
    if not na(h1) and not na(l1)
        if h0 > h1 and l0 > l1
            tr := 1
        else if h0 < h1 and l0 < l1
            tr := -1
    tr

f_zones() =>
    float ph = ta.pivothigh(pivZone, pivZone)
    float pl = ta.pivotlow(pivZone, pivZone)
    float sLo = na(pl) ? na : low[pivZone]
    float sHi = na(pl) ? na : math.min(open[pivZone], close[pivZone])
    float rLo = na(ph) ? na : math.max(open[pivZone], close[pivZone])
    float rHi = na(ph) ? na : high[pivZone]
    float rightLo = ta.lowest(low, pivZone)
    float rightHi = ta.highest(high, pivZone)
    bool sStale = na(pl) ? false : rightLo <= sHi
    bool rStale = na(ph) ? false : rightHi >= rLo
    [sLo[1], sHi[1], rLo[1], rHi[1], sStale[1], rStale[1], time[1]]

int htfTrend = request.security(syminfo.tickerid, tfTrend, f_trend()[1], lookahead = barmerge.lookahead_off)
[zSupLo, zSupHi, zResLo, zResHi, supStale, resStale, zTime] = request.security(syminfo.tickerid, tfZone, f_zones(), lookahead = barmerge.lookahead_off)

type Zone
    float lo
    float hi
    int   born

var array<Zone> supPOI = array.new<Zone>()
var array<Zone> resPOI = array.new<Zone>()

// возвращает число вытесненных (Pine не даёт менять глобалы внутри функции)
f_prune(array<Zone> arr, int cap) =>
    int n = 0
    while array.size(arr) > cap
        int worst = 0
        float wd = -1.0
        for i = 0 to array.size(arr) - 1
            Zone z = array.get(arr, i)
            float d = math.abs(close - (z.lo + z.hi) / 2)
            if d > wd
                wd := d
                worst := i
        array.remove(arr, worst)
        n += 1
    n

// ================= СЧЁТЧИКИ =================
var int aSraw = 0      // пивотов найдено
var int aRraw = 0
var int aS    = 0      // зон реально создано (после bornFresh)
var int aR    = 0
var int bornKillS = 0  // отсеяно bornFresh
var int bornKillR = 0
var int bS    = 0      // вытеснено лимитом слотов
var int bR    = 0
var int cUp   = 0
var int cDn   = 0
var int cFlat = 0
var int dS    = 0      // касаний свежих зон (без учёта тренда)
var int dR    = 0
var int dTrend = 0     // касаний, совпавших с трендом = окон
var int e     = 0
var int fRej  = 0
var int fSwp  = 0
var int g     = 0
var int nBars = 0
var int emptyS = 0     // баров без единой живой зоны поддержки
var int emptyR = 0
var int farS   = 0     // баров, где ближайшая зона дальше deadMult×ATR
var int farR   = 0
var array<float> ageSamp = array.new_float()

float atrv = ta.atr(atrLen)

bool newZoneBar = not na(zTime) and (na(zTime[1]) or zTime != zTime[1])

if newZoneBar
    if not na(zSupLo)
        aSraw += 1
        if bornFresh and supStale
            bornKillS += 1
        else
            array.push(supPOI, Zone.new(zSupLo, zSupHi, bar_index))
            aS += 1
    if not na(zResLo)
        aRraw += 1
        if bornFresh and resStale
            bornKillR += 1
        else
            array.push(resPOI, Zone.new(zResLo, zResHi, bar_index))
            aR += 1
    bS += f_prune(supPOI, maxZones)
    bR += f_prune(resPOI, maxZones)

// ---- c: распределение состояний тренда
nBars += 1
if htfTrend == 1
    cUp += 1
else if htfTrend == -1
    cDn += 1
else
    cFlat += 1

// ---- мёртвые слоты и возраст зон
float nearS = na
if array.size(supPOI) > 0
    for i = 0 to array.size(supPOI) - 1
        Zone z = array.get(supPOI, i)
        float d = math.abs(close - z.hi)
        if na(nearS) or d < nearS
            nearS := d
float nearR = na
if array.size(resPOI) > 0
    for i = 0 to array.size(resPOI) - 1
        Zone z = array.get(resPOI, i)
        float d = math.abs(close - z.lo)
        if na(nearR) or d < nearR
            nearR := d

if array.size(supPOI) == 0
    emptyS += 1
else if not na(atrv) and nearS > deadMult * atrv
    farS += 1
if array.size(resPOI) == 0
    emptyR += 1
else if not na(atrv) and nearR > deadMult * atrv
    farR += 1

if bar_index % ageEvery == 0
    if array.size(supPOI) > 0
        for i = 0 to array.size(supPOI) - 1
            array.push(ageSamp, float(bar_index - array.get(supPOI, i).born))
    if array.size(resPOI) > 0
        for i = 0 to array.size(resPOI) - 1
            array.push(ageSamp, float(bar_index - array.get(resPOI, i).born))

// ================= СОСТОЯНИЕ ОКНА (копия v1.1) =================
var int   winDir  = 0
var int   winLeft = 0
var float winLo   = na
var float winHi   = na
var int   trigDir  = 0
var int   trigLeft = 0
var float trigHi   = na
var float trigLo   = na

// ---- g: подтверждение
if trigDir != 0
    bool windowGone = confirmInsideWindow and winLeft <= 0
    bool conf = trigDir == 1 ? close > trigHi : close < trigLo
    if conf and not windowGone
        g += 1
        trigDir := 0
    else
        trigLeft -= 1
        if trigLeft <= 0 or windowGone
            trigDir := 0

// ---- d: касания свежих зон, убийство касанием (poiKill=touch как в строгой v1.1)
float tchLo = na
float tchHi = na
if array.size(supPOI) > 0
    for i = array.size(supPOI) - 1 to 0
        Zone z = array.get(supPOI, i)
        bool entered = low <= z.hi and (na(low[1]) or low[1] > z.hi)
        if bar_index > z.born and entered
            if na(tchLo) or z.lo < tchLo
                tchLo := z.lo
                tchHi := z.hi
        if bar_index > z.born and low <= z.hi
            array.remove(supPOI, i)

float tchResLo = na
float tchResHi = na
if array.size(resPOI) > 0
    for i = array.size(resPOI) - 1 to 0
        Zone z = array.get(resPOI, i)
        bool entered = high >= z.lo and (na(high[1]) or high[1] < z.lo)
        if bar_index > z.born and entered
            if na(tchResHi) or z.hi > tchResHi
                tchResLo := z.lo
                tchResHi := z.hi
        if bar_index > z.born and high >= z.lo
            array.remove(resPOI, i)

if not na(tchLo)
    dS += 1
if not na(tchResHi)
    dR += 1

// ---- e: окно открывается только при совпадении с трендом
if not na(tchLo) and htfTrend == 1
    dTrend += 1
    e += 1
    winDir  := 1
    winLo   := tchLo
    winHi   := tchHi
    winLeft := entryWindow
    trigDir := 0
else if not na(tchResHi) and htfTrend == -1
    dTrend += 1
    e += 1
    winDir  := -1
    winLo   := tchResLo
    winHi   := tchResHi
    winLeft := entryWindow
    trigDir := 0

// ---- f: триггеры, раздельно rejection / sweep
if winDir != 0 and winLeft > 0 and trigDir == 0
    float rng = high - low
    bool bigEnough = rng >= minRangeAtr * atrv
    bool rej = false
    bool swp = false
    if winDir == 1
        float wick = math.min(open, close) - low
        rej := rng > 0 and wick >= wickRatio * rng and close > open and low <= winHi and low >= winLo and bigEnough
        swp := low < winLo and close >= winLo
    else
        float wick = high - math.max(open, close)
        rej := rng > 0 and wick >= wickRatio * rng and close < open and high >= winLo and high <= winHi and bigEnough
        swp := high > winHi and close <= winHi
    if rej or swp
        if rej
            fRej += 1
        else
            fSwp += 1
        trigDir  := winDir
        trigLeft := confirmBars
        trigHi   := high
        trigLo   := low

if winLeft > 0
    winLeft -= 1
    if winLeft == 0
        winDir := 0

// ================= ВЫВОД =================
f_median(array<float> a) =>
    float m = na
    if array.size(a) > 0
        array<float> c = array.copy(a)
        array.sort(c, order.ascending)
        int n = array.size(c)
        int h = int(n / 2)
        m := n % 2 == 1 ? array.get(c, h) : (array.get(c, h - 1) + array.get(c, h)) / 2
    m

f_pct(int x, int tot) => tot > 0 ? 100.0 * x / tot : 0.0

var table t = table.new(position.top_right, 1, 6)
if barstate.islastconfirmedhistory or barstate.islast
    table.cell(t, 0, 0, "MSNRdiag " + syminfo.ticker + " " + tfTrend + "/" + tfZone + "/" + timeframe.period +
         " p" + str.tostring(pivTrend) + "-" + str.tostring(pivZone) + " слотов" + str.tostring(maxZones) +
         " баров " + str.tostring(nBars),
         text_color = color.white, bgcolor = color.new(color.purple, 20), text_size = size.small)
    table.cell(t, 0, 1, "a зоны: пивотов S" + str.tostring(aSraw) + " R" + str.tostring(aRraw) +
         " → создано S" + str.tostring(aS) + " R" + str.tostring(aR) +
         " | bornFresh срезал S" + str.tostring(bornKillS) + " R" + str.tostring(bornKillR),
         text_color = color.white, bgcolor = color.new(color.purple, 40), text_size = size.small)
    table.cell(t, 0, 2, "b вытеснено лимитом слотов: S" + str.tostring(bS) + " R" + str.tostring(bR) +
         " (" + str.tostring(f_pct(bS + bR, aS + aR), "#.#") + "% созданных)",
         text_color = color.white, bgcolor = color.new(color.purple, 50), text_size = size.small)
    table.cell(t, 0, 3, "c тренд H4: +1 " + str.tostring(f_pct(cUp, nBars), "#.#") + "% | −1 " +
         str.tostring(f_pct(cDn, nBars), "#.#") + "% | 0 " + str.tostring(f_pct(cFlat, nBars), "#.#") + "%",
         text_color = color.white, bgcolor = color.new(color.purple, 60), text_size = size.small)
    table.cell(t, 0, 4, "d касаний свежих зон S" + str.tostring(dS) + " R" + str.tostring(dR) +
         " → по тренду " + str.tostring(dTrend) + " = e окон " + str.tostring(e) +
         " → f триггеров rej" + str.tostring(fRej) + " swp" + str.tostring(fSwp) +
         " → g подтв. " + str.tostring(g),
         text_color = color.white, bgcolor = color.new(color.purple, 70), text_size = size.small)
    table.cell(t, 0, 5, "мёртвые слоты: S пусто " + str.tostring(f_pct(emptyS, nBars), "#.#") + "% дальше" +
         str.tostring(deadMult, "#.#") + "ATR " + str.tostring(f_pct(farS, nBars), "#.#") + "%" +
         " | R пусто " + str.tostring(f_pct(emptyR, nBars), "#.#") + "% дальше " + str.tostring(f_pct(farR, nBars), "#.#") + "%" +
         " | медиана возраста зон " + str.tostring(f_median(ageSamp), "#") + " баров H1-пивота",
         text_color = color.white, bgcolor = color.new(color.purple, 80), text_size = size.small)
