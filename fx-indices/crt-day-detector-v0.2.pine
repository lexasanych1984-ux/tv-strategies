//@version=6
indicator("CRT Day Detector v0.2", "CRT v0.2", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

bool useOB   = input.bool(true, "POI: ордер-блок 1D")
bool useFVG  = input.bool(true, "POI: FVG 1D")
bool useLIQ  = input.bool(true, "POI: ликвидность (pivot 1D)")
int  pivL    = input.int(3, "Pivot: дней слева", minval = 1)
bool showRaw = input.bool(true, "Показывать CRT без POI (серые)")
bool drawZones = input.bool(true, "Рисовать зоны POI")

// ---------- дневная агрегация (работаем на H1) ----------
var float d0o = na
var float d0h = na
var float d0l = na
var float d0c = na
var float d1o = na
var float d1h = na
var float d1l = na
var float d1c = na
var float d2h = na
var float d2l = na

bool newDay = ta.change(time("D")) != 0

// ---------- история завершённых дней ----------
var array<float> Do = array.new_float()
var array<float> Dh = array.new_float()
var array<float> Dl = array.new_float()
var array<float> Dc = array.new_float()

// ---------- POI-зоны ----------
type Zone
    float top
    float bot
    int   dir   // -1 = медвежья (для шорт-CRT), +1 = бычья
    int   kind  // 1 = OB, 2 = FVG
    box   bx

var array<Zone> zones = array.new<Zone>()

type Liq
    float lvl
    int   dir   // -1 = pivot high (ликвидность сверху), +1 = pivot low
    line  ln

var array<Liq> liqs = array.new<Liq>()

// кластеры отката для OB (индексы в массивах D*)
var int bearClStart = -1
var int bullClStart = -1

f_clHigh(int fromIdx, int toIdx) =>
    float m = -1.0e18
    for i = fromIdx to toIdx
        m := math.max(m, array.get(Dh, i))
    m

f_clLow(int fromIdx, int toIdx) =>
    float m = 1.0e18
    for i = fromIdx to toIdx
        m := math.min(m, array.get(Dl, i))
    m

// ---------- сигнал ----------
var int crtDir = 0
var float sweepLvl = na
var int rawS = 0
var int rawL = 0
var int poiS = 0
var int poiL = 0

if barstate.isfirst
    d0o := open
    d0h := high
    d0l := low
    d0c := close

if newDay and not barstate.isfirst
    // сдвиг: завершившийся день становится днём -1
    d2h := d1h
    d2l := d1l
    d1o := d0o
    d1h := d0h
    d1l := d0l
    d1c := d0c
    d0o := open
    d0h := high
    d0l := low
    d0c := close
    crtDir := 0
    sweepLvl := na
    // ---- 1) CRT-тест: зоны/уровни сейчас в состоянии на конец дня-диапазона (d2)
    if not na(d2h)
        bool shortCRT = d1h > d2h and d1c < d2h and d1l > d2l
        bool longCRT  = d1l < d2l and d1c > d2l and d1h < d2h
        int dir = shortCRT ? -1 : longCRT ? 1 : 0
        if dir != 0
            bool hitOB = false
            bool hitFVG = false
            bool hitLIQ = false
            float tip = dir < 0 ? d1h : d1l
            if array.size(zones) > 0
                for i = 0 to array.size(zones) - 1
                    Zone z = array.get(zones, i)
                    if z.dir == dir and tip >= z.bot and tip <= z.top
                        if z.kind == 1
                            hitOB := true
                        else
                            hitFVG := true
            if array.size(liqs) > 0
                for i = 0 to array.size(liqs) - 1
                    Liq q = array.get(liqs, i)
                    if q.dir == dir
                        if dir < 0 and d1h >= q.lvl and d1c < q.lvl
                            hitLIQ := true
                        if dir > 0 and d1l <= q.lvl and d1c > q.lvl
                            hitLIQ := true
            bool poiOK = (useOB and hitOB) or (useFVG and hitFVG) or (useLIQ and hitLIQ)
            string dstr = str.format_time(time("D") + 12 * 3600 * 1000, "yyyy-MM-dd", "UTC")
            if dir < 0
                rawS += 1
            else
                rawL += 1
            if poiOK
                crtDir := dir
                sweepLvl := dir < 0 ? d2h : d2l
                if dir < 0
                    poiS += 1
                else
                    poiL += 1
                string tags = ""
                if hitOB
                    tags := "OB"
                if hitFVG
                    tags := tags == "" ? "FVG" : tags + "+FVG"
                if hitLIQ
                    tags := tags == "" ? "LIQ" : tags + "+LIQ"
                label.new(bar_index, tip, (dir < 0 ? "CRT SHORT " : "CRT LONG ") + dstr + " [" + tags + "]",
                     style = dir < 0 ? label.style_label_down : label.style_label_up,
                     color = dir < 0 ? color.new(color.red, 20) : color.new(color.green, 20),
                     textcolor = color.white, size = size.small)
            else if showRaw
                label.new(bar_index, tip, (dir < 0 ? "crt s " : "crt l ") + dstr,
                     style = dir < 0 ? label.style_label_down : label.style_label_up,
                     color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
    // ---- 2) применяем завершённый день (d1) к истории, зонам и уровням
    array.push(Do, d1o)
    array.push(Dh, d1h)
    array.push(Dl, d1l)
    array.push(Dc, d1c)
    int idx = array.size(Dh) - 1
    float h = d1h
    float l = d1l
    float c = d1c
    bool bull = d1c > d1o
    bool bear = d1c < d1o
    // медвежий OB: кластер начинается с бычьей свечи; валидация = закрытие ниже лоу кластера
    if bearClStart >= 0 and idx > bearClStart
        float ch = f_clHigh(bearClStart, idx - 1)
        float cl = f_clLow(bearClStart, idx - 1)
        if c < cl
            box b = drawZones ? box.new(bar_index, ch, bar_index, cl, border_color = color.new(color.red, 55), bgcolor = color.new(color.red, 92), extend = extend.right) : na
            array.push(zones, Zone.new(ch, cl, -1, 1, b))
            bearClStart := bull ? idx : -1
        else if c > ch
            bearClStart := bull ? idx : -1
    if bearClStart < 0 and bull
        bearClStart := idx
    // бычий OB: кластер начинается с медвежьей свечи; валидация = закрытие выше хая кластера
    if bullClStart >= 0 and idx > bullClStart
        float ch2 = f_clHigh(bullClStart, idx - 1)
        float cl2 = f_clLow(bullClStart, idx - 1)
        if c > ch2
            box b2 = drawZones ? box.new(bar_index, ch2, bar_index, cl2, border_color = color.new(color.teal, 55), bgcolor = color.new(color.teal, 92), extend = extend.right) : na
            array.push(zones, Zone.new(ch2, cl2, 1, 1, b2))
            bullClStart := bear ? idx : -1
        else if c < cl2
            bullClStart := bear ? idx : -1
    if bullClStart < 0 and bear
        bullClStart := idx
    // FVG по трём последним завершённым дням
    if idx >= 2
        float aH = array.get(Dh, idx - 2)
        float aL = array.get(Dl, idx - 2)
        if aL > h
            box fb = drawZones ? box.new(bar_index, aL, bar_index, h, border_color = color.new(color.orange, 45), bgcolor = color.new(color.orange, 92), extend = extend.right) : na
            array.push(zones, Zone.new(aL, h, -1, 2, fb))
        if aH < l
            box fb2 = drawZones ? box.new(bar_index, l, bar_index, aH, border_color = color.new(color.lime, 45), bgcolor = color.new(color.lime, 92), extend = extend.right) : na
            array.push(zones, Zone.new(l, aH, 1, 2, fb2))
    // инвалидация зон закрытием дня за дальней границей
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            bool kill = z.dir == -1 ? c > z.top : c < z.bot
            if kill
                if not na(z.bx)
                    box.set_extend(z.bx, extend.none)
                    box.set_right(z.bx, bar_index)
                array.remove(zones, i)
    // pivot-уровни ликвидности (подтверждение через 1 день)
    int p = idx - 1
    if p >= pivL
        float ph = array.get(Dh, p)
        float pl = array.get(Dl, p)
        bool isPH = ph > h
        bool isPL = pl < l
        for k = 1 to pivL
            isPH := isPH and ph > array.get(Dh, p - k)
            isPL := isPL and pl < array.get(Dl, p - k)
        if isPH
            line lnh = drawZones ? line.new(bar_index, ph, bar_index + 1, ph, extend = extend.right, color = color.new(color.purple, 35), style = line.style_dotted) : na
            array.push(liqs, Liq.new(ph, -1, lnh))
        if isPL
            line lnl = drawZones ? line.new(bar_index, pl, bar_index + 1, pl, extend = extend.right, color = color.new(color.blue, 35), style = line.style_dotted) : na
            array.push(liqs, Liq.new(pl, 1, lnl))
    // снятие уровней текущим днём
    if array.size(liqs) > 0
        for i = array.size(liqs) - 1 to 0
            Liq q = array.get(liqs, i)
            bool taken = q.dir == -1 ? h > q.lvl : l < q.lvl
            if taken
                if not na(q.ln)
                    line.set_extend(q.ln, extend.none)
                    line.set_x2(q.ln, bar_index)
                array.remove(liqs, i)
else if not newDay
    d0h := math.max(d0h, high)
    d0l := math.min(d0l, low)
    d0c := close

bgcolor(crtDir < 0 ? color.new(color.red, 88) : crtDir > 0 ? color.new(color.green, 88) : na)
plot(crtDir != 0 ? sweepLvl : na, "Sweep level", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)

var table t = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(t, 0, 0, "CRT v0.2 | raw S" + str.tostring(rawS) + " L" + str.tostring(rawL) + " | POI S" + str.tostring(poiS) + " L" + str.tostring(poiL) + (timeframe.period == "60" ? "" : " / TF=" + timeframe.period + " (нужен 60!)"), text_color = color.white, bgcolor = color.new(color.blue, 30))
