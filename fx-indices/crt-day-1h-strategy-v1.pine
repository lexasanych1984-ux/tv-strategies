//@version=6
strategy("CRT Day 1H Strategy v1", "CRTS v1", overlay = true, initial_capital = 100000, pyramiding = 0,
     margin_long = 0, margin_short = 0,
     max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

bool dbg = input.bool(true, "Отладка: метки исходов по дням", group = "Отладка")
int dbgFrom = input.time(timestamp("10 Mar 2026 00:00 +0000"), "Отладка: старт детального лога", group = "Отладка")
bool dbgTrace = input.bool(false, "Отладка: лог касаний/сбросов (48ч от старта)", group = "Отладка")

// ================= ИНПУТЫ =================
bool useOB   = input.bool(true,  "D1 POI: ордер-блок", group = "Дневной фильтр POI")
bool useFVG  = input.bool(true,  "D1 POI: FVG", group = "Дневной фильтр POI")
bool useLIQ  = input.bool(true,  "D1 POI: ликвидность (pivot)", group = "Дневной фильтр POI")
int  pivL    = input.int(3, "Pivot: дней слева", minval = 1, group = "Дневной фильтр POI")

bool useH1FVG = input.bool(true, "H1 зона: FVG", group = "Вход H1")
bool useH1OB  = input.bool(true, "H1 зона: ордер-блок", group = "Вход H1")
int  h1MaxAge = input.int(72, "Макс. возраст H1 зоны (баров)", minval = 6, group = "Вход H1")
string sess   = input.session("1000-2300", "Окно пробоя (рабочее время)", group = "Вход H1")
string protMode = input.string("range", "Проторговка", options = ["range", "pause"], tooltip = "range: диапазон дня до касания зоны, вход на пробое его края. pause: бегущий экстремум, вход после паузы импульса", group = "Вход H1")
string nightMode = input.string("dead", "Ночной пробой проторговки", options = ["dead", "rearm", "limit"], tooltip = "dead: сетап сгорел. rearm: ждём новое касание и новую проторговку. limit: лимитный вход на уровне пробитого края (разрешён и ночью)", group = "Вход H1")
string sessTz = input.string("Europe/Moscow", "Таймзона окна", group = "Вход H1")
bool cancelBeyondManip = input.bool(true, "Отмена, если день закрепился за экстремумом манипуляции", group = "Вход H1")
bool touchInSess = input.bool(false, "Касание зоны только в сессию", group = "Вход H1")

float rrMult  = input.float(2.2, "RR (тейк = RR × риск)", step = 0.1, group = "Риск")
float riskPct = input.float(1.0, "Риск на сделку, % от эквити", step = 0.25, group = "Риск")
int  newsMode = input.int(0, "Красные новости: 0=выкл, 1=день без торговли, 2=окно ±мин", minval = 0, maxval = 2, group = "Фильтры")
int  newsWin  = input.int(60, "Окно вокруг новости, мин (режим 2)", minval = 5, step = 5, group = "Фильтры")
bool nightOff = input.bool(false, "Не торговать ночью (вся механика только в рабочем окне)", group = "Фильтры")
bool reentryBE = input.bool(false, "Перезаход: выход вчерашней позиции (БУ) не блокирует день", group = "Фильтры")
string crtClose = input.string("inside", "Закрытие манипуляции", options = ["inside", "beyond", "any"], tooltip = "inside: возврат внутрь диапазона (классика). beyond: закрытие за свипнутым экстремумом. any: оба", group = "Вариации")
string stopMode = input.string("dayExt", "Стоп", options = ["dayExt", "h1zone"], tooltip = "dayExt: за экстремум дня. h1zone: за границу H1-зоны касания", group = "Вариации")
int minRangeBars = input.int(1, "Мин. баров проторговки до касания", minval = 1, group = "Вариации")
bool entryInPrevRange = input.bool(false, "Вход внутри диапазона пред. дня (лонг ≥ лоу, шорт ≤ хай)", group = "Вариации")

// ================= ДНЕВНОЙ СЛОЙ (порт v0.2) =================
var float d0o = na
var float d0h = na
var float d0l = na
var float d0c = na
var float d1o = na
var float d1h = na
var float d1l = na
var float d1c = na
var float d2h = na
var float d2l = na

bool newDay = ta.change(time("D")) != 0

var array<float> Do = array.new_float()
var array<float> Dh = array.new_float()
var array<float> Dl = array.new_float()
var array<float> Dc = array.new_float()

type Zone
    float top
    float bot
    int   dir
    int   kind  // 1=OB, 2=FVG
    int   born

var array<Zone> zones  = array.new<Zone>()   // дневные POI
var array<Zone> hzones = array.new<Zone>()   // часовые зоны реакции

type Liq
    float lvl
    int   dir

var array<Liq> liqs = array.new<Liq>()

var int bearClStart = -1
var int bullClStart = -1

f_clHigh(int fromIdx, int toIdx) =>
    float m = -1.0e18
    for i = fromIdx to toIdx
        m := math.max(m, array.get(Dh, i))
    m

f_clLow(int fromIdx, int toIdx) =>
    float m = 1.0e18
    for i = fromIdx to toIdx
        m := math.min(m, array.get(Dl, i))
    m

// ================= СОСТОЯНИЕ ТОРГОВОГО ДНЯ =================
var int   tDir = 0
var float tD1h = na
var float tD1l = na
var bool  touched = false
var bool  paused = false
var float entryLvl = na
var float dayExt = na
var bool  setupDead = false
var bool  tradeDone = false
var float curSL = na
var float curTP = na
var bool  beDone = false
var bool  dayBlocked = false
var int   poiS = 0
var int   poiL = 0
var int   cntEnt = 0
var int   cntBlk = 0
var int   cntDead = 0
var int   cntTch = 0
var int   cntNoTch = 0
var int   barsInPos = 0
var float entPx = na
var float entSL = na
var float entTP = na
var int   cntTP = 0
var int   cntBE = 0
var int   cntSL = 0

bool inSession = not na(time(timeframe.period, sess, sessTz))
// начнётся ли СЛЕДУЮЩИЙ бар в сессии (ордер, выставленный на закрытии текущего, живёт в следующем)
int sessStartH = int(str.tonumber(str.substring(sess, 0, 2)))
int sessEndH = int(str.tonumber(str.substring(sess, 5, 7)))
int nextH = hour(time_close, sessTz)
bool nextInSess = sessStartH <= sessEndH ? (nextH >= sessStartH and nextH < sessEndH) : (nextH >= sessStartH or nextH < sessEndH)
var bool orderLive = false
var bool limitArmed = false
var bool posFromPrevDay = false
var float touchZBound = na  // граница H1-зоны касания (стоп в режиме h1zone)
var int rngBars = 0         // баров проторговки до касания

// ───── Красные новости: NFP, CPI США, FOMC (решение+прессконф), ЕЦБ (решение+прессконф), UTC
// Покрытие: июнь 2021 – июль 2026 (для 5-летних реплей-прогонов)
var array<int> newsTs = array.new<int>()

// решение + прессконференция через 30 мин
f_pushEvt(array<int> arr, int ts) =>
    array.push(arr, ts)
    array.push(arr, ts + 1800000)

