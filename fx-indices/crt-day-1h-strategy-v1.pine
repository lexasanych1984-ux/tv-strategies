    f_pushEvt(newsTs, timestamp("GMT", 2023,  9, 14, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2023, 10, 26, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2023, 12, 14, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024,  1, 25, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024,  3,  7, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024,  4, 11, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024,  6,  6, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024,  7, 18, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024,  9, 12, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024, 10, 17, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2024, 12, 12, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025,  1, 30, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025,  3,  6, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025,  4, 17, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025,  6,  5, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025,  7, 24, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025,  9, 11, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025, 10, 30, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2025, 12, 18, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2026,  2,  5, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2026,  3, 19, 13, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2026,  4, 30, 12, 15))
    f_pushEvt(newsTs, timestamp("GMT", 2026,  6, 11, 12, 15))
    array.sort(newsTs, order.ascending)

newsWinMs = newsWin * 60 * 1000
f_newsBlocked() =>
    bool blk = false
    if newsMode > 0 and array.size(newsTs) > 0
        for i = 0 to array.size(newsTs) - 1
            int ts = array.get(newsTs, i)
            if newsMode == 1
                if ts > time + 86400000
                    break
                if year(time, "GMT") == year(ts, "GMT") and month(time, "GMT") == month(ts, "GMT") and dayofmonth(time, "GMT") == dayofmonth(ts, "GMT")
                    blk := true
                    break
            else
                if ts - newsWinMs > time_close
                    break
                if time_close <= ts + newsWinMs
                    blk := true
                    break
    blk
newsBlk = f_newsBlocked()


if barstate.isfirst
    d0o := open
    d0h := high
    d0l := low
    d0c := close

if newDay and not barstate.isfirst
    // ---- итог вчерашнего сетапа (отладка)
    if tDir != 0
        string oc = tradeDone ? "ENT" : dayBlocked ? "BLK" : setupDead ? "DEAD" : touched ? "TCH" : "NOTCH"
        if oc == "ENT"
            cntEnt += 1
        if oc == "BLK"
            cntBlk += 1
        if oc == "DEAD"
            cntDead += 1
        if oc == "TCH"
            cntTch += 1
        if oc == "NOTCH"
            cntNoTch += 1
        if dbg
            string extra = oc == "ENT" ? " e" + str.tostring(entPx, format.mintick) + " sl" + str.tostring(entSL, format.mintick) + " tp" + str.tostring(entTP, format.mintick) : ""
            label.new(bar_index - 1, low, oc + " " + str.format_time(time("D")[1] + 12 * 3600 * 1000, "MM-dd", "UTC") + extra,
                 style = label.style_label_up, color = oc == "ENT" ? color.new(color.blue, 30) : color.new(color.gray, 60),
                 textcolor = color.white, size = size.tiny)
    // ---- сдвиг дней
    d2h := d1h
    d2l := d1l
    d1o := d0o
    d1h := d0h
    d1l := d0l
    d1c := d0c
    d0o := open
    d0h := high
    d0l := low
    d0c := close
    // ---- перевод в БУ: позиция пережила торговый день
    posFromPrevDay := strategy.position_size != 0
    if strategy.position_size != 0 and not beDone
        curSL := strategy.position_avg_price
        beDone := true
    // ---- сброс дневного сетапа
    tDir := 0
    touched := false
    paused := false
    entryLvl := na
    touchZBound := na
    rngBars := 0
    setupDead := false
    tradeDone := false
    orderLive := false
    limitArmed := false
    strategy.cancel_all()
    // ---- CRT-тест (зоны в состоянии на конец дня-диапазона d2)
    if not na(d2h)
        bool shortCRT = d1h > d2h and d1l > d2l and (crtClose == "inside" ? d1c < d2h : crtClose == "beyond" ? d1c > d2h : true)
        bool longCRT  = d1l < d2l and d1h < d2h and (crtClose == "inside" ? d1c > d2l : crtClose == "beyond" ? d1c < d2l : true)
        int dir = shortCRT ? -1 : longCRT ? 1 : 0
        if dir != 0
            bool hitOB = false
            bool hitFVG = false
            bool hitLIQ = false
            float tip = dir < 0 ? d1h : d1l
            if array.size(zones) > 0
                for i = 0 to array.size(zones) - 1
                    Zone z = array.get(zones, i)
                    if z.dir == dir and tip >= z.bot and tip <= z.top
                        if z.kind == 1
                            hitOB := true
                        else
                            hitFVG := true
            if array.size(liqs) > 0
                for i = 0 to array.size(liqs) - 1
                    Liq q = array.get(liqs, i)
                    if q.dir == dir
                        if dir < 0 and d1h >= q.lvl and d1c < q.lvl
                            hitLIQ := true
                        if dir > 0 and d1l <= q.lvl and d1c > q.lvl
                            hitLIQ := true
            if (useOB and hitOB) or (useFVG and hitFVG) or (useLIQ and hitLIQ)
                tDir := dir
                tD1h := d1h
                tD1l := d1l
                dayExt := dir < 0 ? high : low
                dayBlocked := strategy.position_size != 0
                if dir < 0
                    poiS += 1
                else
                    poiL += 1
    // ---- применяем завершённый день d1 к дневным структурам
    array.push(Do, d1o)
    array.push(Dh, d1h)
    array.push(Dl, d1l)
    array.push(Dc, d1c)
    int idx = array.size(Dh) - 1
    float dh = d1h
    float dl = d1l
    float dc = d1c
    bool dBull = d1c > d1o
    bool dBear = d1c < d1o
    if bearClStart >= 0 and idx > bearClStart
        float ch = f_clHigh(bearClStart, idx - 1)
        float cl = f_clLow(bearClStart, idx - 1)
        if dc < cl
            array.push(zones, Zone.new(ch, cl, -1, 1, idx))
            bearClStart := dBull ? idx : -1
        else if dc > ch
            bearClStart := dBull ? idx : -1
    if bearClStart < 0 and dBull
        bearClStart := idx
    if bullClStart >= 0 and idx > bullClStart
        float ch2 = f_clHigh(bullClStart, idx - 1)
        float cl2 = f_clLow(bullClStart, idx - 1)
        if dc > ch2
            array.push(zones, Zone.new(ch2, cl2, 1, 1, idx))
            bullClStart := dBear ? idx : -1
        else if dc < cl2
            bullClStart := dBear ? idx : -1
    if bullClStart < 0 and dBear
        bullClStart := idx
    if idx >= 2
        float aH = array.get(Dh, idx - 2)
        float aL = array.get(Dl, idx - 2)
        if aL > dh
            array.push(zones, Zone.new(aL, dh, -1, 2, idx))
        if aH < dl
            array.push(zones, Zone.new(dl, aH, 1, 2, idx))
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            if z.dir == -1 ? dc > z.top : dc < z.bot
                array.remove(zones, i)
    int p = idx - 1
    if p >= pivL
        float ph = array.get(Dh, p)
        float pl = array.get(Dl, p)
        bool isPH = ph > dh
        bool isPL = pl < dl
        for k = 1 to pivL
            isPH := isPH and ph > array.get(Dh, p - k)
            isPL := isPL and pl < array.get(Dl, p - k)
        if isPH
            array.push(liqs, Liq.new(ph, -1))
        if isPL
            array.push(liqs, Liq.new(pl, 1))
    if array.size(liqs) > 0
        for i = array.size(liqs) - 1 to 0
            Liq q = array.get(liqs, i)
            if q.dir == -1 ? dh > q.lvl : dl < q.lvl
                array.remove(liqs, i)
else if not newDay
    d0h := math.max(d0h, high)
    d0l := math.min(d0l, low)
    d0c := close

// ================= ЧАСОВЫЕ ЗОНЫ (H1 FVG + H1 OB) =================
var float hBearClHigh = na
var float hBearClLow = na
var float hBullClHigh = na
var float hBullClLow = na

// H1 OB: кластер контртрендовых свечей, валидация закрытием за экстремум
if useH1OB
    if not na(hBearClHigh)
        if close < hBearClLow
            array.push(hzones, Zone.new(hBearClHigh, hBearClLow, -1, 1, bar_index))
            hBearClHigh := close > open ? high : na
            hBearClLow := close > open ? low : na
        else if close > hBearClHigh
            hBearClHigh := close > open ? high : na
            hBearClLow := close > open ? low : na
        else
            hBearClHigh := math.max(hBearClHigh, high)
            hBearClLow := math.min(hBearClLow, low)
    else if close > open
        hBearClHigh := high
        hBearClLow := low
    if not na(hBullClHigh)
        if close > hBullClHigh
            array.push(hzones, Zone.new(hBullClHigh, hBullClLow, 1, 1, bar_index))
            hBullClHigh := close < open ? high : na
            hBullClLow := close < open ? low : na
        else if close < hBullClLow
            hBullClHigh := close < open ? high : na
            hBullClLow := close < open ? low : na
        else
            hBullClHigh := math.max(hBullClHigh, high)
            hBullClLow := math.min(hBullClLow, low)
    else if close < open
        hBullClHigh := high
        hBullClLow := low

// H1 FVG
if useH1FVG and bar_index >= 2
    if low[2] > high
        array.push(hzones, Zone.new(low[2], high, -1, 2, bar_index))
    if high[2] < low
        array.push(hzones, Zone.new(low, high[2], 1, 2, bar_index))

// инвалидация и старение H1 зон
if array.size(hzones) > 0
    for i = array.size(hzones) - 1 to 0
        Zone z = array.get(hzones, i)
        bool kill = (z.dir == -1 ? close > z.top : close < z.bot) or bar_index - z.born > h1MaxAge
        if kill
            array.remove(hzones, i)

// ================= МЕХАНИКА ТОРГОВОГО ДНЯ =================
if tDir != 0 and not tradeDone and (strategy.position_size == 0 or (reentryBE and posFromPrevDay)) and (not nightOff or inSession)
    // экстремум дня (стоп «за большой OB»)
    dayExt := tDir < 0 ? math.max(dayExt, high) : math.min(dayExt, low)
    // отмена: день закрепился за экстремумом манипуляции
    if cancelBeyondManip and (tDir < 0 ? close > tD1h : close < tD1l)
        setupDead := true
    // касание часовой зоны своего направления
    bool dbgWin = dbgTrace and time >= dbgFrom and time <= dbgFrom + 48 * 3600 * 1000
    // режим range: накапливаем диапазон дня, пока нет касания
    if protMode == "range" and not touched and not setupDead
        entryLvl := na(entryLvl) ? (tDir < 0 ? low : high) : (tDir < 0 ? math.min(entryLvl, low) : math.max(entryLvl, high))
        rngBars += 1
    if not touched and not setupDead and (not touchInSess or inSession) and array.size(hzones) > 0
        float zt = na
        float zb = na
        int zk = 0
        for i = 0 to array.size(hzones) - 1
            Zone z = array.get(hzones, i)
            if z.dir == tDir and bar_index > z.born and high >= z.bot and low <= z.top and (protMode != "range" or rngBars >= minRangeBars)
                touched := true
                zt := z.top
                zb := z.bot
                zk := z.kind
                touchZBound := tDir < 0 ? z.top : z.bot
        if touched
            if protMode == "pause"
                entryLvl := tDir < 0 ? low : high
            paused := false
            if dbgWin
                label.new(bar_index, high, "T" + (zk == 1 ? "OB " : "FVG ") + str.tostring(zb, format.mintick) + "-" + str.tostring(zt, format.mintick), style = label.style_label_down, color = color.new(color.yellow, 20), textcolor = color.black, size = size.tiny)
    else if touched and not setupDead
        if protMode == "range"
            // уровень заморожен при касании; пробой без живого ордера
            if not orderLive and not limitArmed and (tDir < 0 ? low < entryLvl : high > entryLvl)
                if nightMode == "dead"
                    setupDead := true
                else if nightMode == "rearm"
                    touched := false
                    entryLvl := na
                else
                    limitArmed := true
        else
            // pause: импульс продолжается (новый экстремум) → минимум сдвигается, паузы нет;
            // бар без нового экстремума = проторговка (пауза) → можно ставить стоп-ордер
            if tDir < 0 ? low < entryLvl : high > entryLvl
                entryLvl := tDir < 0 ? low : high
                paused := false
            else
                paused := true
                if dbgWin and not paused[1]
                    label.new(bar_index, high, "PAUSE " + str.tostring(entryLvl, format.mintick), style = label.style_label_down, color = color.new(color.olive, 20), textcolor = color.white, size = size.tiny)

// детальный бар-лог в окне отладки (в таблицу)
var string dbgLog = ""
if dbgTrace and time >= dbgFrom and time <= dbgFrom + 48 * 3600 * 1000 and str.length(dbgLog) < 3800
    dbgLog += str.format_time(time, "dd HH:mm", "UTC") + " l=" + str.tostring(low, format.mintick) + " c=" + str.tostring(close, format.mintick) + " d" + str.tostring(tDir) + " t" + (touched ? "1" : "0") + " p" + (paused ? "1" : "0") + " e" + str.tostring(entryLvl, format.mintick) + " s" + (inSession ? "1" : "0") + "\n"

// фиксация факта сделки в этот день — ДО блока ордеров, чтобы не перевыставить ордер
// на закрытии бара, внутри которого сделка успела открыться и закрыться
var int lastClosedCnt = 0
if strategy.closedtrades > lastClosedCnt
    // классификация исхода: ближайший из уровней ТР / вход (БУ) / SL
    float ep = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    if not na(ep) and not na(entTP) and not na(entPx) and not na(entSL)
        float dTP = math.abs(ep - entTP)
        float dBE = math.abs(ep - entPx)
        float dSL = math.abs(ep - entSL)
        if dTP <= dBE and dTP <= dSL
            cntTP += 1
        else if dBE <= dSL
            cntBE += 1
        else
            cntSL += 1
    // выход вчерашней позиции при reentryBE не съедает сегодняшний сетап
    if not (reentryBE and posFromPrevDay)
        tradeDone := true
    posFromPrevDay := false
lastClosedCnt := strategy.closedtrades
if strategy.position_size != 0 and strategy.position_size[1] == 0
    tradeDone := true
    entPx := strategy.position_avg_price
    entSL := curSL
    entTP := curTP

// выставление/снятие ордеров (на закрытии каждого бара)
if strategy.position_size == 0
    bool entryOK = not entryInPrevRange or (tDir < 0 ? entryLvl <= tD1h : entryLvl >= tD1l)
    if limitArmed and tDir != 0 and not setupDead and not tradeDone and not newsBlk and entryOK
        // ночной пробой → лимитный вход на уровне пробитого края (ретест)
        float slLvlL = stopMode == "h1zone" and not na(touchZBound) ? touchZBound : dayExt
        float stopDistL = tDir < 0 ? slLvlL - entryLvl : entryLvl - slLvlL
        if stopDistL > syminfo.mintick * 5
            float qtyL = strategy.equity * riskPct / 100 / stopDistL
            curSL := slLvlL
            curTP := tDir < 0 ? entryLvl - rrMult * stopDistL : entryLvl + rrMult * stopDistL
            beDone := false
            if tDir < 0
                strategy.entry("CRT S", strategy.short, qty = qtyL, limit = entryLvl, alert_message = "CRT SHORT (лимит) " + syminfo.ticker + " | вход " + str.tostring(entryLvl, format.mintick) + " | SL " + str.tostring(curSL, format.mintick) + " | TP " + str.tostring(curTP, format.mintick) + " | RR " + str.tostring(rrMult, "#.#"))
                strategy.exit("X", "CRT S", stop = curSL, limit = curTP, alert_message = "CRT ВЫХОД short " + syminfo.ticker)
            else
                strategy.entry("CRT L", strategy.long, qty = qtyL, limit = entryLvl, alert_message = "CRT LONG (лимит) " + syminfo.ticker + " | вход " + str.tostring(entryLvl, format.mintick) + " | SL " + str.tostring(curSL, format.mintick) + " | TP " + str.tostring(curTP, format.mintick) + " | RR " + str.tostring(rrMult, "#.#"))
                strategy.exit("X", "CRT L", stop = curSL, limit = curTP, alert_message = "CRT ВЫХОД long " + syminfo.ticker)
    else if tDir != 0 and touched and (protMode == "range" or paused) and not setupDead and not tradeDone and not newsBlk and entryOK and nextInSess and (tDir < 0 ? close > entryLvl : close < entryLvl)
        float slLvl = stopMode == "h1zone" and not na(touchZBound) ? touchZBound : dayExt
        float stopDist = tDir < 0 ? slLvl - entryLvl : entryLvl - slLvl
        if stopDist > syminfo.mintick * 5
            float qty = strategy.equity * riskPct / 100 / stopDist
            curSL := slLvl
            curTP := tDir < 0 ? entryLvl - rrMult * stopDist : entryLvl + rrMult * stopDist
            beDone := false
            orderLive := true
            if tDir < 0
                strategy.entry("CRT S", strategy.short, qty = qty, stop = entryLvl, alert_message = "CRT SHORT " + syminfo.ticker + " | вход " + str.tostring(entryLvl, format.mintick) + " | SL " + str.tostring(curSL, format.mintick) + " | TP " + str.tostring(curTP, format.mintick) + " | RR " + str.tostring(rrMult, "#.#"))
                strategy.exit("X", "CRT S", stop = curSL, limit = curTP, alert_message = "CRT ВЫХОД short " + syminfo.ticker)
            else
                strategy.entry("CRT L", strategy.long, qty = qty, stop = entryLvl, alert_message = "CRT LONG " + syminfo.ticker + " | вход " + str.tostring(entryLvl, format.mintick) + " | SL " + str.tostring(curSL, format.mintick) + " | TP " + str.tostring(curTP, format.mintick) + " | RR " + str.tostring(rrMult, "#.#"))
                strategy.exit("X", "CRT L", stop = curSL, limit = curTP, alert_message = "CRT ВЫХОД long " + syminfo.ticker)
        else
            orderLive := false
    else
        orderLive := false
        strategy.cancel_all()
else
    // позиция открыта: держим exit актуальным (после БУ stop = цена входа)
    strategy.exit("X", stop = curSL, limit = curTP, alert_message = "CRT ВЫХОД " + syminfo.ticker + (beDone ? " (после БУ)" : ""))

if strategy.position_size != 0
    barsInPos += 1

// ================= ВИЗУАЛИЗАЦИЯ И МАРКЕР =================
bgcolor(tDir < 0 ? color.new(color.red, 90) : tDir > 0 ? color.new(color.green, 90) : na)
plot(tDir != 0 and touched and not setupDead and strategy.position_size == 0 ? entryLvl : na, "Уровень входа", color = color.new(color.blue, 20), style = plot.style_linebr)

// помесячные доходности (для сверки с боевыми потоками)
bool showMonthly = input.bool(false, "Таблица помесячных доходностей", group = "Отладка")
var string moLog = ""
var float moStartEq = na
if ta.change(month) != 0 or barstate.isfirst
    if not na(moStartEq) and moStartEq > 0 and str.length(moLog) < 3800
        float moRet = (strategy.equity - moStartEq) / moStartEq * 100
        moLog += str.format_time(time - 86400000, "yyyy-MM", "UTC") + " " + (moRet >= 0 ? "+" : "") + str.tostring(moRet, "#.##") + "%\n"
    moStartEq := strategy.equity

var table tm = table.new(position.bottom_left, 1, 1)
if (barstate.islastconfirmedhistory or barstate.islast) and showMonthly and moLog != ""
    table.cell(tm, 0, 0, moLog, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.tiny, text_halign = text.align_left)

var table tl = table.new(position.middle_left, 1, 1)
if (barstate.islastconfirmedhistory or barstate.islast) and dbgTrace and dbgLog != ""
    table.cell(tl, 0, 0, dbgLog, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.tiny, text_halign = text.align_left)

var table t = table.new(position.top_right, 1, 2)
if barstate.islastconfirmedhistory or barstate.islast
    table.cell(t, 0, 0, "CRTS v2.0-" + protMode + "-" + nightMode + (newsMode > 0 ? "-N" + str.tostring(newsMode) : "") + (nightOff ? "-ДЕНЬ" : "") + (reentryBE ? "-RE" : "") + "-" + crtClose + "-" + stopMode + "-m" + str.tostring(minRangeBars) + " | poi S" + str.tostring(poiS) + " L" + str.tostring(poiL) + " | trades " + str.tostring(strategy.closedtrades) + (timeframe.period == "60" ? "" : " / TF=" + timeframe.period + " (нужен 60!)"), text_color = color.white, bgcolor = color.new(color.navy, 20))
    table.cell(t, 0, 1, "ENT " + str.tostring(cntEnt) + " | BLK " + str.tostring(cntBlk) + " | DEAD " + str.tostring(cntDead) + " | TCH " + str.tostring(cntTch) + " | NOTCH " + str.tostring(cntNoTch) + " | TP " + str.tostring(cntTP) + " BE " + str.tostring(cntBE) + " SL " + str.tostring(cntSL), text_color = color.white, bgcolor = color.new(color.navy, 40))
