//@version=6
strategy("Asia Sweep IDX v1", shorttitle="ASweep v1", overlay=true, initial_capital=10000, slippage=5, process_orders_on_close=true, margin_long=0, margin_short=0, max_boxes_count=500, max_labels_count=500)

// ── Входы ─────────────────────────────────────────────
riskPct   = input.float(2.0, "Риск, % equity", minval=0.1, step=0.5)
minRR     = input.float(1.0, "Минимальный RR", minval=0.1, step=0.1)
tzStr     = input.string("GMT+3", "Таймзона сессий")
asiaSess  = input.session("0200-0900", "Азиатская сессия")
entrySess = input.session("0900-1200", "Окно входа (Лондон)")
biasMode  = input.string("Both", "Режим направления", options=["Both", "Auto FVG H4", "Auto ZOI H4", "Long only", "Short only"])
useImp    = input.bool(true, "Импульсный закреп")
impMult   = input.float(1.0, "Импульс: тело >= X*SMA(тел,20)", minval=0.1, step=0.1)
slBufT    = input.int(0, "Буфер стопа, тики", minval=0)
useNoGap  = input.bool(true, "Гэп не считается свипом (нужна проторговка до уровня)")
useNews   = input.bool(true, "Фильтр новостей (NFP/CPI/FOMC/ЕЦБ)")
newsWin   = input.int(30, "Окно новостей, +/- мин", minval=5)
useTrendF = input.bool(false, "SWEEP не против дневного тренда (2 дня подряд)")
maxZoiAtr = input.float(1.0, "Макс. дистанция до зоны, xATR(H4,14); 0=выкл", minval=0, step=0.5)
showViz   = input.bool(false, "Показывать линии Азии, фон и таблицу")
showTrades = input.bool(true, "Рисовать сделки (long/short боксы)")
trigMode  = input.string("Диапазон", "Закреп за проторговкой", options=["Диапазон", "Поглощение серии"])
useAtrReg = input.bool(false, "Режим: торговать только при ATR(D,14) > SMA(ATR,50)")
minAsiaW  = input.float(0, "Мин. ширина Азии, xATR(D,14); 0=выкл", minval=0, step=0.1)
maxAsiaW  = input.float(0, "Макс. ширина Азии, xATR(D,14); 0=выкл", minval=0, step=0.1)
useNewsDay = input.bool(false, "Скип ВЕСЬ день новости (не только +/- окно)")

