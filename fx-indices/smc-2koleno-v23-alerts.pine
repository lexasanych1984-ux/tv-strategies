//@version=6
strategy("SMC 2-е колено 4H→M15", "SMC-2L", overlay=true,
     initial_capital=10000, pyramiding=0, margin_long=0, margin_short=0,
     calc_on_every_tick=false, process_orders_on_close=true, slippage=5,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ───── Настройки
riskPct    = input.float(1.0, "Риск на сделку, %", minval=0.1, step=0.1)
rrMult     = input.float(3.0, "Тейк-профит, R (если нет ликвы)", minval=0.5, step=0.5)
htfTF      = input.timeframe("240", "ТФ контекста (структура/зоны)")
frH        = input.int(2, "Контекст: плечо фрактала", minval=1)
frL        = input.int(2, "Вход: плечо фрактала", minval=1)
maxBos     = input.int(1, "Макс. № BOS в тренде (1 = только 2-е колено, 10 = все)", minval=1, maxval=10)
useFVG     = input.bool(true, "POI: FVG контекста")
useOB      = input.bool(true, "POI: Ордерблок контекста")
useSWP     = input.bool(true, "POI: Свип фрактала контекста")
poiLifeH   = input.int(42, "Жизнь сетапа, баров контекста", minval=5)
useFta     = input.bool(false, "FTA-фильтр")
ftaLiq     = input.bool(true, "FTA: учитывать ликвидность (фракталы HTF)")
ftaMinR    = input.float(1.0, "Мин. расстояние до FTA, R", minval=0.5, step=0.25)
tpLiq      = input.bool(true, "Тейк до ликвидности HTF")
tpMinR     = input.float(1.5, "Мин. RR до ликвы (иначе пропуск)", minval=0.5, step=0.25)
tpBuf      = input.int(20, "Отступ тейка от ликвы, тики", minval=0)
tradeLong  = input.bool(true, "Торговать Long")
tradeShort = input.bool(true, "Торговать Short")
useSess    = input.bool(true, "Входы только в сессии Лондон/Нью-Йорк")
sessLon    = input.session("0800-1700", "Лондон (Europe/London)")
sessNY     = input.session("0800-1700", "Нью-Йорк (America/New_York)")
showZones  = input.bool(false, "Показывать зоны POI")
showTrades = input.bool(true, "Рисовать сделки (long/short боксы)")
newsMode   = input.int(0, "Красные новости: 0=выкл, 1=день без торговли, 2=окно ±мин", minval=0, maxval=2)
newsWin    = input.int(30, "Окно вокруг новости, мин (режим 2)", minval=5, step=5)
riskComp   = input.bool(true, "Риск от текущего депозита (реинвест)")
useStopBand = input.bool(true, "Фильтр размера стопа (коридор, пипсы)")
minStopPip  = input.float(20.0, "Мин. стоп, пипсов", minval=0.0, step=1.0)
maxStopPip  = input.float(60.0, "Макс. стоп, пипсов", minval=0.0, step=5.0)
useAtrBand  = input.bool(true, "Стоп-коридор по ATR HTF (заменяет пипсовый)")
atrBandMin  = input.float(0.4, "Мин. стоп, ×ATR HTF", minval=0.0, step=0.1)
atrBandMax  = input.float(1.2, "Макс. стоп, ×ATR HTF", minval=0.0, step=0.1)

htfMs = timeframe.in_seconds(htfTF) * 1000
barsPerHtf = math.max(1, math.round(timeframe.in_seconds(htfTF) / timeframe.in_seconds(timeframe.period)))
pipSz = syminfo.mintick * 10

// ───── Сессионный фильтр
inSess = not useSess or not na(time(timeframe.period, sessLon, "Europe/London")) or not na(time(timeframe.period, sessNY, "America/New_York"))

// ───── Красные новости: NFP, CPI США, FOMC (решение+прессконф), ЕЦБ (решение+прессконф), UTC
// Покрытие: июнь 2021 – июль 2026 (для 5-летних реплей-прогонов)
var array<int> newsTs = array.new<int>()

// решение + прессконференция через 30 мин
f_pushEvt(array<int> arr, int ts) =>
    array.push(arr, ts)
    array.push(arr, ts + 1800000)

if barstate.isfirst
