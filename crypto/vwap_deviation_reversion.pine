//@version=6
// =============================================================================
//  VWAP DEVIATION REVERSION — интрадей-реверсия к сессионному VWAP
//  Инструмент: BTC/ETH перпетуалы Bybit   ТФ графика: 15m
//  Режим рынка: БОКОВИК (низкий ADX + цена в коридоре вокруг H1 EMA200)
//
//  Идея: выброс за полосу 2σ от сессионного VWAP (якорь 00:00 UTC) с возвратом
//  внутрь на следующей свече + перекупленность/перепроданность по RSI.
//  Цель — возврат к VWAP (70% позиции) и к противоположной полосе 1σ (остаток).
//
//  ТОЛЬКО БЭКТЕСТ И ВИЗУАЛЬНАЯ ПРОВЕРКА. Алертов/вебхуков в скрипте нет.
//  Repainting: request.security только с lookahead_off и по закрытому бару [1].
// =============================================================================

strategy("VWAP Deviation Reversion 15m", shorttitle="VWAP-REV", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, calc_on_every_tick=false, process_orders_on_close=true, pyramiding=0)

// -----------------------------------------------------------------------------
// ИНПУТЫ
// -----------------------------------------------------------------------------
G_RISK = "1 · Риск и размер позиции"
riskPct = input.float(1.0, "Риск на сделку, % эквити", minval=0.05, maxval=10.0, step=0.05, group=G_RISK, tooltip="Объём считается от расстояния до стопа, а не фиксированной долей депозита.")
maxLev  = input.float(5.0, "Потолок плеча (notional / equity)", minval=0.5, maxval=25.0, step=0.5, group=G_RISK, tooltip="Страховка: при очень узком стопе риск-сайзинг иначе выдаёт нереальную позицию.")

G_REG = "2 · Режимный фильтр (без него входы запрещены)"
adxLen    = input.int(14, "ADX: длина DI", minval=2, group=G_REG)
adxSmooth = input.int(14, "ADX: сглаживание", minval=1, group=G_REG)
adxMax    = input.float(22.0, "Торговать при ADX <", minval=5.0, maxval=60.0, step=0.5, group=G_REG)
htfTf     = input.timeframe("60", "Старший ТФ для EMA-коридора", group=G_REG)
htfEmaLen = input.int(200, "Длина EMA на старшем ТФ", minval=10, group=G_REG)
bandPct   = input.float(1.5, "Коридор вокруг EMA, ±%", minval=0.1, maxval=10.0, step=0.1, group=G_REG)

G_VWAP = "3 · VWAP и полосы отклонения"
vwapSrc = input.source(hlc3, "Источник VWAP", group=G_VWAP)
dev1    = input.float(1.0, "Полоса 1σ", minval=0.1, maxval=5.0, step=0.1, group=G_VWAP)
dev2    = input.float(2.0, "Полоса 2σ", minval=0.2, maxval=6.0, step=0.1, group=G_VWAP)

G_SIG = "4 · Сигнальная свеча"
rsiLen   = input.int(14, "RSI: длина", minval=2, group=G_SIG)
rsiLong  = input.float(28.0, "RSI < X для лонга", minval=1.0, maxval=50.0, step=1.0, group=G_SIG)
rsiShort = input.float(72.0, "RSI > X для шорта", minval=50.0, maxval=99.0, step=1.0, group=G_SIG)

G_A = "5 · A-setup (свип ближайшего экстремума)"
aOnly    = input.bool(false, "A-setup only: требовать свип перед сигналом", group=G_A)
sweepN   = input.int(20, "Экстремум последних N баров", minval=3, maxval=200, group=G_A)
sweepWin = input.int(3, "Свип не старше, баров", minval=1, maxval=20, group=G_A, tooltip="Свип = пробой экстремума хвостом с возвратом закрытия обратно.")

G_EXIT = "6 · Стоп, тейки, тайм-стоп"
atrLen    = input.int(14, "ATR: длина", minval=2, group=G_EXIT)
atrStopK  = input.float(0.5, "Стоп = экстремум сигнальной свечи ± ATR ×", minval=0.0, maxval=3.0, step=0.1, group=G_EXIT)
tp1Pct    = input.float(70.0, "Тейк 1 (VWAP): закрыть % позиции", minval=10.0, maxval=95.0, step=5.0, group=G_EXIT)
timeStopN = input.int(12, "Тайм-стоп: баров без касания VWAP", minval=2, maxval=200, group=G_EXIT)

G_VIS = "7 · Визуализация"
showBands = input.bool(true, "Полосы VWAP", group=G_VIS)
showLvls  = input.bool(true, "Уровни входа / стопа / тейков", group=G_VIS)
showBg    = input.bool(true, "Подсветка разрешённого режима", group=G_VIS)
showTbl   = input.bool(true, "Таблица статистики", group=G_VIS)
tblCorner = input.string("Верхний правый", "Угол таблицы", options=["Верхний правый", "Верхний левый", "Нижний правый", "Нижний левый"], group=G_VIS)

// -----------------------------------------------------------------------------
// РЕЖИМНЫЙ ФИЛЬТР
// -----------------------------------------------------------------------------
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmooth)

// Закрытый бар старшего ТФ ([1]) + lookahead_off = нет заглядывания в будущее.
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)

adxOk    = not na(adxVal) and adxVal < adxMax
emaOk    = not na(htfEma) and htfEma > 0 and math.abs(close - htfEma) / htfEma * 100.0 <= bandPct
regimeOk = adxOk and emaOk

// -----------------------------------------------------------------------------
// СЕССИОННЫЙ VWAP (якорь 00:00 UTC) + полосы 1σ / 2σ
// -----------------------------------------------------------------------------
utcDay    = dayofmonth(time, "UTC")
newUtcDay = na(utcDay[1]) or utcDay != utcDay[1]

[vwapVal, up1, lo1] = ta.vwap(vwapSrc, newUtcDay, dev1)

// Полосы 2σ выводим из 1σ — одно и то же стандартное отклонение, лишний вызов не нужен.
sigma = (up1 - vwapVal) / dev1
up2   = vwapVal + sigma * dev2
lo2   = vwapVal - sigma * dev2

// -----------------------------------------------------------------------------
// СИГНАЛ
// -----------------------------------------------------------------------------
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

// Свип: хвост пробил экстремум предыдущих N баров, а закрытие вернулось обратно.
priorLow  = ta.lowest(low, sweepN)[1]
priorHigh = ta.highest(high, sweepN)[1]
sweepDn   = not na(priorLow) and low < priorLow and close > priorLow
sweepUp   = not na(priorHigh) and high > priorHigh and close < priorHigh
barsSinceDn = ta.barssince(sweepDn)
barsSinceUp = ta.barssince(sweepUp)
sweepOkLong  = not aOnly or (not na(barsSinceDn) and barsSinceDn <= sweepWin)
sweepOkShort = not aOnly or (not na(barsSinceUp) and barsSinceUp <= sweepWin)

// Выброс за 2σ на прошлой свече + возврат внутрь на текущей (сигнальной).
longSig  = regimeOk and close[1] < lo2[1] and close > lo2 and rsiVal < rsiLong and sweepOkLong
shortSig = regimeOk and close[1] > up2[1] and close < up2 and rsiVal > rsiShort and sweepOkShort

// Стоп — за экстремум сигнальной свечи с запасом в долях ATR.
stopLongPx  = low - atrStopK * atrVal
stopShortPx = high + atrStopK * atrVal

// -----------------------------------------------------------------------------
// РАЗМЕР ПОЗИЦИИ ОТ РИСКА
// -----------------------------------------------------------------------------
posQty(float stopDist) =>
    riskAmt = strategy.equity * riskPct / 100.0
    raw     = stopDist > 0 ? riskAmt / stopDist : 0.0
    capQty  = close > 0 ? maxLev * strategy.equity / close : 0.0
    math.max(0.0, math.min(raw, capQty))

// -----------------------------------------------------------------------------
// ИСПОЛНЕНИЕ
// -----------------------------------------------------------------------------
var float stopPx      = na
var int   entryBar    = na
var bool  touchedVwap = false

isFlat     = strategy.position_size == 0
longEntry  = longSig and isFlat
shortEntry = shortSig and isFlat

if longEntry
    stopDist = close - stopLongPx
    qty = posQty(stopDist)
    if stopDist > 0 and qty > 0
        stopPx := stopLongPx
        strategy.entry("L", strategy.long, qty=qty, comment="Rev Long")

if shortEntry
    stopDist = stopShortPx - close
    qty = posQty(stopDist)
    if stopDist > 0 and qty > 0
        stopPx := stopShortPx
        strategy.entry("S", strategy.short, qty=qty, comment="Rev Short")

// Момент открытия позиции: заявка исполняется по закрытию сигнального бара,
// поэтому фиксируем счётчики на следующем баре по переходу размера позиции.
justEntered = strategy.position_size != 0 and strategy.position_size[1] == 0
if justEntered
    entryBar := bar_index
    touchedVwap := false

inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0

if inLong and high >= vwapVal
    touchedVwap := true
if inShort and low <= vwapVal
    touchedVwap := true

// Тейк 1 — VWAP (частично), тейк 2 — противоположная полоса 1σ (остаток).
// Уровни плавающие, поэтому заявки переставляются на каждом баре.
if inLong
    strategy.exit("L TP1", from_entry="L", qty_percent=tp1Pct, limit=vwapVal, stop=stopPx)
    strategy.exit("L TP2", from_entry="L", limit=up1, stop=stopPx)
if inShort
    strategy.exit("S TP1", from_entry="S", qty_percent=tp1Pct, limit=vwapVal, stop=stopPx)
    strategy.exit("S TP2", from_entry="S", limit=lo1, stop=stopPx)

barsInTrade = na(entryBar) ? 0 : bar_index - entryBar
if strategy.position_size != 0 and not touchedVwap and barsInTrade >= timeStopN
    strategy.close_all(comment="Тайм-стоп")

// -----------------------------------------------------------------------------
// ВИЗУАЛИЗАЦИЯ
// -----------------------------------------------------------------------------
plot(vwapVal, "VWAP", color=color.new(color.orange, 0), linewidth=2)
pUp1 = plot(showBands ? up1 : na, "+1σ", color=color.new(color.teal, 45))
pLo1 = plot(showBands ? lo1 : na, "-1σ", color=color.new(color.teal, 45))
pUp2 = plot(showBands ? up2 : na, "+2σ", color=color.new(color.purple, 25), linewidth=2)
pLo2 = plot(showBands ? lo2 : na, "-2σ", color=color.new(color.purple, 25), linewidth=2)
fill(pUp1, pLo1, color=color.new(color.teal, 94), title="Коридор 1σ")
fill(pUp2, pUp1, color=color.new(color.purple, 92), title="Зона перекупленности")
fill(pLo1, pLo2, color=color.new(color.purple, 92), title="Зона перепроданности")

inPos = strategy.position_size != 0
plot(showLvls and inPos ? strategy.position_avg_price : na, "Вход", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)
plot(showLvls and inPos ? stopPx : na, "Стоп", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
tp2Px = inLong ? up1 : lo1
plot(showLvls and inPos ? tp2Px : na, "Тейк 2", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

bgcolor(showBg and regimeOk ? color.new(color.teal, 92) : na, title="Режим разрешает торговлю")
plotshape(longEntry, "Сигнал лонг", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.tiny)
plotshape(shortEntry, "Сигнал шорт", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.tiny)

// -----------------------------------------------------------------------------
// ТАБЛИЦА СТАТИСТИКИ
// -----------------------------------------------------------------------------
// Просадка считается по кривой эквити самого скрипта (в % от пика).
var float peakEquity = na
peakEquity := math.max(nz(peakEquity, strategy.equity), strategy.equity)
ddNow = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100.0 : 0.0
var float maxDdPct = 0.0
maxDdPct := math.max(maxDdPct, ddNow)

tblPos = tblCorner == "Верхний левый" ? position.top_left : tblCorner == "Нижний правый" ? position.bottom_right : tblCorner == "Нижний левый" ? position.bottom_left : position.top_right
var table stats = table.new(tblPos, 2, 6, border_width=1, frame_width=1, frame_color=color.new(color.gray, 40), border_color=color.new(color.gray, 60), bgcolor=color.new(color.black, 78))

if showTbl and barstate.islast
    nTrades = strategy.closedtrades
    winrate = nTrades > 0 ? 100.0 * strategy.wintrades / nTrades : 0.0
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    netPct  = strategy.initial_capital > 0 ? strategy.netprofit / strategy.initial_capital * 100.0 : 0.0
    table.cell(stats, 0, 0, "VWAP-REV", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(stats, 1, 0, timeframe.period, text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(stats, 0, 1, "Сделок", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 1, str.tostring(nTrades), text_color=color.white, text_size=size.small)
    table.cell(stats, 0, 2, "Winrate", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 2, str.tostring(winrate, "#.0") + " %", text_color=winrate >= 50 ? color.lime : color.orange, text_size=size.small)
    table.cell(stats, 0, 3, "Profit factor", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 3, na(pf) ? "—" : str.tostring(pf, "#.00"), text_color=(na(pf) or pf >= 1.0) ? color.lime : color.red, text_size=size.small)
    table.cell(stats, 0, 4, "Max DD", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 4, str.tostring(maxDdPct, "#.0") + " %", text_color=color.orange, text_size=size.small)
    table.cell(stats, 0, 5, "Чистая прибыль", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 5, str.tostring(netPct, "#.0") + " %", text_color=netPct >= 0 ? color.lime : color.red, text_size=size.small)
