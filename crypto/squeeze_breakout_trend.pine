//@version=6
// =============================================================================
//  SQUEEZE BREAKOUT TREND — пробой сжатия волатильности по тренду
//  Инструмент: BTC/ETH перпетуалы Bybit   ТФ графика: 15m
//  Режим рынка: ТРЕНД (направление задаёт EMA50/EMA200 со старшего ТФ H4)
//
//  Идея: полосы Боллинджера полностью внутри канала Кельтнера ≥ N баров
//  (сжатие), затем закрытие за пределами BB в сторону старшего тренда
//  на повышенном объёме. Фиксированного тейка нет — ведём Supertrend'ом.
//
//  ТОЛЬКО БЭКТЕСТ И ВИЗУАЛЬНАЯ ПРОВЕРКА. Алертов/вебхуков в скрипте нет.
//  Repainting: request.security только с lookahead_off и по закрытому бару [1].
// =============================================================================

strategy("Squeeze Breakout Trend 15m", shorttitle="SQZ-BO", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, calc_on_every_tick=false, process_orders_on_close=true, pyramiding=0)

// -----------------------------------------------------------------------------
// ИНПУТЫ
// -----------------------------------------------------------------------------
G_RISK = "1 · Риск и размер позиции"
riskPct = input.float(1.0, "Риск на сделку, % эквити", minval=0.05, maxval=10.0, step=0.05, group=G_RISK, tooltip="Объём считается от расстояния до стопа, а не фиксированной долей депозита.")
maxLev  = input.float(5.0, "Потолок плеча (notional / equity)", minval=0.5, maxval=25.0, step=0.5, group=G_RISK, tooltip="Страховка: при очень узком стопе риск-сайзинг иначе выдаёт нереальную позицию.")

G_REG = "2 · Режимный фильтр (направление разрешённых сделок)"
htfTf   = input.timeframe("240", "Старший ТФ режима", group=G_REG)
emaFast = input.int(50, "Быстрая EMA старшего ТФ", minval=5, group=G_REG)
emaSlow = input.int(200, "Медленная EMA старшего ТФ", minval=20, group=G_REG)

G_SQZ = "3 · Сжатие (BB внутри Keltner)"
bbLen    = input.int(20, "BB: длина", minval=5, group=G_SQZ)
bbMult   = input.float(2.0, "BB: множитель σ", minval=0.5, maxval=5.0, step=0.1, group=G_SQZ)
kcLen    = input.int(20, "Keltner: длина базиса", minval=5, group=G_SQZ)
kcAtrLen = input.int(20, "Keltner: длина ATR", minval=2, group=G_SQZ)
kcMult   = input.float(1.5, "Keltner: множитель ATR", minval=0.5, maxval=5.0, step=0.1, group=G_SQZ)
kcUseEma = input.bool(false, "Базис Keltner на EMA (иначе SMA)", group=G_SQZ)
minSqBars = input.int(6, "Минимум баров сжатия подряд", minval=2, maxval=60, group=G_SQZ)

G_ENT = "4 · Вход (пробой + объём)"
volLen  = input.int(20, "SMA объёма: длина", minval=2, group=G_ENT)
volMult = input.float(1.8, "Объём свечи > SMA ×", minval=1.0, maxval=6.0, step=0.1, group=G_ENT)

G_EXIT = "5 · Стоп и ведение"
atrLen   = input.int(14, "ATR: длина (для стопа)", minval=2, group=G_EXIT)
atrStopK = input.float(1.5, "Стоп: ATR ×", minval=0.3, maxval=6.0, step=0.1, group=G_EXIT, tooltip="Стоп = ближайший из двух: базис BB или это расстояние от цены входа.")
stAtr    = input.int(10, "Supertrend: период ATR", minval=2, group=G_EXIT)
stFactor = input.float(3.0, "Supertrend: множитель", minval=0.5, maxval=10.0, step=0.1, group=G_EXIT)

G_INV = "6 · Инвалидация (для A/B-теста)"
useInval  = input.bool(true, "Выходить при возврате внутрь BB", group=G_INV, tooltip="OFF = пересиживаем до стопа/трейлинга. Это и есть предмет A/B-теста.")
invalBars = input.int(5, "Проверка через N баров после входа", minval=1, maxval=50, group=G_INV)

G_VIS = "7 · Визуализация"
showBands = input.bool(true, "Полосы BB и Keltner", group=G_VIS)
showST    = input.bool(true, "Линия Supertrend", group=G_VIS)
showLvls  = input.bool(true, "Уровни входа / стопа", group=G_VIS)
showBg    = input.bool(true, "Подсветка режима и сжатия", group=G_VIS)
showTbl   = input.bool(true, "Таблица статистики", group=G_VIS)
tblCorner = input.string("Верхний правый", "Угол таблицы", options=["Верхний правый", "Верхний левый", "Нижний правый", "Нижний левый"], group=G_VIS)

// -----------------------------------------------------------------------------
// РЕЖИМНЫЙ ФИЛЬТР — EMA50/EMA200 со старшего ТФ по закрытому бару
// -----------------------------------------------------------------------------
[htfFast, htfSlow] = request.security(syminfo.tickerid, htfTf, [ta.ema(close, emaFast)[1], ta.ema(close, emaSlow)[1]], lookahead=barmerge.lookahead_off)

htfReady    = not na(htfFast) and not na(htfSlow)
longAllowed = htfReady and htfFast > htfSlow
shortAllowed = htfReady and htfFast < htfSlow

// -----------------------------------------------------------------------------
// СЖАТИЕ: BB(20, 2.0) полностью внутри Keltner(20, 1.5×ATR)
// -----------------------------------------------------------------------------
bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// Оба базиса считаем всегда: ta.* внутри тернарника вызывался бы не на каждом
// баре, а это ломает состояние скользящих средних.
kcSma   = ta.sma(close, kcLen)
kcEma   = ta.ema(close, kcLen)
kcBasis = kcUseEma ? kcEma : kcSma
kcRange = kcMult * ta.atr(kcAtrLen)
kcUpper = kcBasis + kcRange
kcLower = kcBasis - kcRange

inSqueeze = bbUpper < kcUpper and bbLower > kcLower
var int sqCount = 0
sqCount := inSqueeze ? nz(sqCount[1]) + 1 : 0
// На баре пробоя сжатие уже, как правило, разорвано — смотрим на предыдущий бар.
sqReady = nz(sqCount[1]) >= minSqBars

// -----------------------------------------------------------------------------
// ВХОД
// -----------------------------------------------------------------------------
volAvg = ta.sma(volume, volLen)
volOk  = not na(volAvg) and volume > volMult * volAvg

longSig  = longAllowed and sqReady and close > bbUpper and volOk
shortSig = shortAllowed and sqReady and close < bbLower and volOk

// Стоп — ближайший к цене входа из двух: базис BB или ATR-дистанция.
atrVal    = ta.atr(atrLen)
atrStopL  = close - atrStopK * atrVal
atrStopS  = close + atrStopK * atrVal
rawStopL  = math.max(bbBasis, atrStopL)
rawStopS  = math.min(bbBasis, atrStopS)
stopLongPx  = rawStopL < close ? rawStopL : atrStopL
stopShortPx = rawStopS > close ? rawStopS : atrStopS

// -----------------------------------------------------------------------------
// РАЗМЕР ПОЗИЦИИ ОТ РИСКА
// -----------------------------------------------------------------------------
posQty(float stopDist) =>
    riskAmt = strategy.equity * riskPct / 100.0
    raw     = stopDist > 0 ? riskAmt / stopDist : 0.0
    capQty  = close > 0 ? maxLev * strategy.equity / close : 0.0
    math.max(0.0, math.min(raw, capQty))

// -----------------------------------------------------------------------------
// ИСПОЛНЕНИЕ
// -----------------------------------------------------------------------------
[stLine, stDir] = ta.supertrend(stFactor, stAtr)

var float stopPx   = na
var int   entryBar = na

isFlat     = strategy.position_size == 0
longEntry  = longSig and isFlat
shortEntry = shortSig and isFlat

if longEntry
    stopDist = close - stopLongPx
    qty = posQty(stopDist)
    if stopDist > 0 and qty > 0
        stopPx := stopLongPx
        strategy.entry("L", strategy.long, qty=qty, comment="Squeeze Long")

if shortEntry
    stopDist = stopShortPx - close
    qty = posQty(stopDist)
    if stopDist > 0 and qty > 0
        stopPx := stopShortPx
        strategy.entry("S", strategy.short, qty=qty, comment="Squeeze Short")

justEntered = strategy.position_size != 0 and strategy.position_size[1] == 0
if justEntered
    entryBar := bar_index

inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0

// Трейлинг Supertrend'ом: стоп только подтягивается, назад не откатывается.
if inLong and not na(stopPx) and stDir < 0 and stLine > stopPx
    stopPx := stLine
if inShort and not na(stopPx) and stDir > 0 and stLine < stopPx
    stopPx := stLine

if inLong
    strategy.exit("L stop", from_entry="L", stop=stopPx)
if inShort
    strategy.exit("S stop", from_entry="S", stop=stopPx)

// Инвалидация: ровно через N баров после входа цена снова внутри BB.
barsInTrade = na(entryBar) ? 0 : bar_index - entryBar
if useInval and barsInTrade == invalBars
    if inLong and close < bbUpper
        strategy.close("L", comment="Инвалидация")
    if inShort and close > bbLower
        strategy.close("S", comment="Инвалидация")

// -----------------------------------------------------------------------------
// ВИЗУАЛИЗАЦИЯ
// -----------------------------------------------------------------------------
pBbU = plot(showBands ? bbUpper : na, "BB верх", color=color.new(color.blue, 20))
pBbL = plot(showBands ? bbLower : na, "BB низ", color=color.new(color.blue, 20))
plot(showBands ? bbBasis : na, "BB базис", color=color.new(color.blue, 55))
pKcU = plot(showBands ? kcUpper : na, "KC верх", color=color.new(color.orange, 35), style=plot.style_stepline)
pKcL = plot(showBands ? kcLower : na, "KC низ", color=color.new(color.orange, 35), style=plot.style_stepline)
fill(pBbU, pKcU, color=color.new(color.orange, 92), title="Сжатие сверху")
fill(pBbL, pKcL, color=color.new(color.orange, 92), title="Сжатие снизу")

plot(showST ? stLine : na, "Supertrend", color=stDir < 0 ? color.new(color.green, 20) : color.new(color.red, 20), style=plot.style_linebr, linewidth=2)

inPos = strategy.position_size != 0
plot(showLvls and inPos ? strategy.position_avg_price : na, "Вход", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)
plot(showLvls and inPos ? stopPx : na, "Стоп / трейлинг", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

regimeTint = longAllowed ? color.new(color.green, 94) : shortAllowed ? color.new(color.red, 94) : na
bgcolor(showBg ? regimeTint : na, title="Разрешённое направление")
plotshape(showBg and inSqueeze, "Сжатие", shape.circle, location.bottom, color.new(color.yellow, 20), size=size.tiny)
plotshape(longEntry, "Пробой вверх", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortEntry, "Пробой вниз", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// -----------------------------------------------------------------------------
// ТАБЛИЦА СТАТИСТИКИ
// -----------------------------------------------------------------------------
var float peakEquity = na
peakEquity := math.max(nz(peakEquity, strategy.equity), strategy.equity)
ddNow = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100.0 : 0.0
var float maxDdPct = 0.0
maxDdPct := math.max(maxDdPct, ddNow)

tblPos = tblCorner == "Верхний левый" ? position.top_left : tblCorner == "Нижний правый" ? position.bottom_right : tblCorner == "Нижний левый" ? position.bottom_left : position.top_right
var table stats = table.new(tblPos, 2, 6, border_width=1, frame_width=1, frame_color=color.new(color.gray, 40), border_color=color.new(color.gray, 60), bgcolor=color.new(color.black, 78))

if showTbl and barstate.islast
    nTrades = strategy.closedtrades
    winrate = nTrades > 0 ? 100.0 * strategy.wintrades / nTrades : 0.0
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    netPct  = strategy.initial_capital > 0 ? strategy.netprofit / strategy.initial_capital * 100.0 : 0.0
    table.cell(stats, 0, 0, "SQZ-BO", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(stats, 1, 0, timeframe.period, text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(stats, 0, 1, "Сделок", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 1, str.tostring(nTrades), text_color=color.white, text_size=size.small)
    table.cell(stats, 0, 2, "Winrate", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 2, str.tostring(winrate, "#.0") + " %", text_color=winrate >= 50 ? color.lime : color.orange, text_size=size.small)
    table.cell(stats, 0, 3, "Profit factor", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 3, na(pf) ? "—" : str.tostring(pf, "#.00"), text_color=(na(pf) or pf >= 1.0) ? color.lime : color.red, text_size=size.small)
    table.cell(stats, 0, 4, "Max DD", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 4, str.tostring(maxDdPct, "#.0") + " %", text_color=color.orange, text_size=size.small)
    table.cell(stats, 0, 5, "Чистая прибыль", text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 5, str.tostring(netPct, "#.0") + " %", text_color=netPct >= 0 ? color.lime : color.red, text_size=size.small)
